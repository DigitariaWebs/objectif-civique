{
  "expo": {
    "name": "Objectif Civique",
    "slug": "objectif-civique",
    "scheme": "objectifcivique",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/branding/icon.png",
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.objectifcivique.app",
      "icon": "./assets/branding/icon-ios.png",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "L'accès à l'appareil photo permet de scanner votre carte bancaire lors d'un paiement, pour éviter d'en saisir le numéro à la main."
      }
    },
    "android": {
      "package": "com.horizon224.objectifcivique",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "969297dd-c639-4af6-a0ce-03000da0b46a"
      }
    },
    "owner": "progix_2026"
  }
}
